COMPOSE_PROJECT_NAME=run-tracker

APP_PORT=8080
VITE_PLEDGE_FORM_URL=
VITE_LIVE_ALERT_CONSENT_TEXT=
VITE_LIVE_ALERT_CONSENT_VERSION=
DB_EXPOSED_PORT=5432

NODE_ENV=production
PORT=3000

POSTGRES_IMAGE=postgres:18-alpine
DB_HOST=db
DB_PORT=5432
DB_NAME=run_tracker
DB_USER=run_tracker
DB_PASSWORD=change-me
DB_SYNCHRONIZE=true

TRACKING_SECRET=change-me-to-a-long-random-secret
EVENT_START_AT=2026-08-13T06:00:00+02:00

# Keep disabled until the consent text, retention period, Garmin device and
# recipient capacities have been approved and tested end to end.
LIVE_ALERTS_ENABLED=false
LIVE_ALERT_EMAIL_CAPACITY=0
LIVE_ALERT_SMS_CAPACITY=0
LIVE_ALERT_CONSENT_VERSION=
LIVE_ALERT_RETENTION_DAYS=
LIVE_ALERT_DATA_KEY=
LIVE_ALERT_RATE_LIMIT_MAX=5
