# Run lifecycle phase shown by the site: pre | live | post
VITE_EVENT_PHASE=pre

# Official start of the run (ISO-8601). Defaults to 2026-08-13T08:00:00+02:00.
VITE_EVENT_START_AT=

# Garmin LiveTrack session URL. Allowed only while VITE_EVENT_PHASE=live.
VITE_LIVE_TRACK_URL=

# Official result, required once VITE_EVENT_PHASE=post: finished | dnf
VITE_RESULT_STATUS=

# Whole seconds from start to finish. Required for a finished result,
# forbidden for dnf. The bet multiplier is derived from this value.
VITE_RESULT_ELAPSED_SECONDS=

# Verified donation total in EUR (optional).
VITE_RESULT_FINAL_DONATION_EUR=

# Approved public result copy (optional).
VITE_RESULT_COPY=
