{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://majootkd.sk/schemas/public-pledges.json",
  "title": "Majo OTKD public pledges",
  "type": "object",
  "additionalProperties": false,
  "required": ["updatedAt", "pledges"],
  "properties": {
    "updatedAt": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "format": "date-time" }
      ]
    },
    "pledges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["displayName", "baseAmountEur"],
        "properties": {
          "displayName": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" }
            ]
          },
          "baseAmountEur": {
            "type": "number",
            "exclusiveMinimum": 0,
            "multipleOf": 0.01
          }
        }
      }
    }
  }
}
