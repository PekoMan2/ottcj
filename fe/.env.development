# Development values, used by `npm run dev`.

# Unlike production, any phase can be forced here for local testing:
# pre | live | post (post also needs the VITE_RESULT_* values).
# Empty = derived from VITE_EVENT_START_AT exactly like production.
VITE_EVENT_PHASE=

# Test start date in the past so the site derives "live" locally.
# Set a future date to see the countdown and the notify card instead.
VITE_EVENT_START_AT=2026-08-05T21:00:00+02:00

# Any https://*.garmin.com URL works for local testing.
VITE_GARMIN_URL=

VITE_OFFICIAL_TRACKING_URL=https://sunbell.tracktherace.com/sk/sportove-udalosti/beh-v-prirode/od-tatier-k-dunaju-2026-solo/pretek
VITE_DONIO_URL=https://donio.sk/zachranme-vilyho/majo-od-tatier-k-dunaju
VITE_NOTIFY_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSegRzumYZgOYlFeqTv3LtHKBqYCAIrzDHKDBrFOXDu5JQi2yA/viewform

VITE_RESULT_STATUS=
VITE_RESULT_ELAPSED_SECONDS=
VITE_RESULT_FINAL_DONATION_EUR=
VITE_RESULT_COPY=
