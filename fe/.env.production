# Production values, used by `npm run build` (locally and inside Docker).
# Any change here needs a rebuild + redeploy to reach the site.

# The phase is derived automatically: before VITE_EVENT_START_AT the site is
# "pre", from that moment on it is "live". Set this to "post" manually
# (together with the VITE_RESULT_* values) once the run is over.
# "pre" and "live" cannot be forced in production builds.
VITE_EVENT_PHASE=

# Official start of the run (ISO-8601).
VITE_EVENT_START_AT=2026-08-13T08:00:00+02:00

# Majo's Garmin LiveTrack session URL (backup tracking). Paste it right
# after the start and rebuild; while empty the site shows a pending state.
VITE_GARMIN_URL=

# Official OTKD solo-runners live tracking.
VITE_OFFICIAL_TRACKING_URL=https://sunbell.tracktherace.com/sk/sportove-udalosti/beh-v-prirode/od-tatier-k-dunaju-2026-solo/pretek

# Donio campaign all donation CTAs link to.
VITE_DONIO_URL=https://donio.sk/zachranme-vilyho/majo-od-tatier-k-dunaju

# Google Form collecting run-start notification signups.
VITE_NOTIFY_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSegRzumYZgOYlFeqTv3LtHKBqYCAIrzDHKDBrFOXDu5JQi2yA/viewform

# Official result, set manually together with VITE_EVENT_PHASE=post:
# finished | dnf
VITE_RESULT_STATUS=

# Whole seconds from start to finish. Required for a finished result,
# forbidden for dnf. The bet multiplier is derived from this value.
VITE_RESULT_ELAPSED_SECONDS=

# Verified donation total in EUR (optional).
VITE_RESULT_FINAL_DONATION_EUR=

# Approved public result copy (optional).
VITE_RESULT_COPY=
