FROM node:24-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

ARG VITE_EVENT_PHASE
ARG VITE_EVENT_START_AT
ARG VITE_LIVE_TRACK_URL
ARG VITE_RESULT_STATUS
ARG VITE_RESULT_ELAPSED_SECONDS
ARG VITE_RESULT_FINAL_DONATION_EUR
ARG VITE_RESULT_COPY
ENV VITE_EVENT_PHASE=$VITE_EVENT_PHASE \
    VITE_EVENT_START_AT=$VITE_EVENT_START_AT \
    VITE_LIVE_TRACK_URL=$VITE_LIVE_TRACK_URL \
    VITE_RESULT_STATUS=$VITE_RESULT_STATUS \
    VITE_RESULT_ELAPSED_SECONDS=$VITE_RESULT_ELAPSED_SECONDS \
    VITE_RESULT_FINAL_DONATION_EUR=$VITE_RESULT_FINAL_DONATION_EUR \
    VITE_RESULT_COPY=$VITE_RESULT_COPY

RUN npm run build

FROM nginx:alpine AS runtime

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
